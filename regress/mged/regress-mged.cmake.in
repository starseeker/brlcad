# Values set at CMake configure time
set(CBDIR "@CMAKE_CURRENT_BINARY_DIR@")
set(CSDIR "@CMAKE_CURRENT_SOURCE_DIR@")
set(TNAME "@TNAME@")
set(LOGFILE "@LOG_FILE@")
set(TEST_DB "@TEST_DB@")
set(TEST_EXPECT "@TEST_EXPECT@")
set(TEST_REJECT "@TEST_REJECT@")
set(TEST_SOURCE "@TEST_SOURCE@")
set(TEST_KEEP_DB "@TEST_KEEP_DB@")

# Separate all mutable files, including fixed-name outputs in older scripts.
set(TEST_WORKING_DIRECTORY "${CBDIR}/${TNAME}")
file(REMOVE_RECURSE "${TEST_WORKING_DIRECTORY}")
file(MAKE_DIRECTORY "${TEST_WORKING_DIRECTORY}")

set(BU_DIR_CACHE ${CBDIR}/cache_${TNAME})
set(LIBRT_CACHE ${CBDIR}/rtcache_${TNAME})
set(ENV{BU_DIR_CACHE} ${BU_DIR_CACHE})
set(ENV{LIBRT_CACHE} ${LIBRT_CACHE})
file(REMOVE_RECURSE "${BU_DIR_CACHE}")
file(REMOVE_RECURSE "${LIBRT_CACHE}")
file(MAKE_DIRECTORY "${BU_DIR_CACHE}")
file(MAKE_DIRECTORY "${LIBRT_CACHE}")

file(WRITE "${LOGFILE}" "Starting mged test run\n")

# The executable locations aren't know at CMake configure time, so it is passed
# in via the EXEC variable at runtime by a generator expression in the parent
# build.  De-quote it and assign it to the appropriate variable.
string(REPLACE "\\" "" MGED_EXEC "${EXEC}")
if(NOT EXISTS "${MGED_EXEC}")
  file(WRITE "${LOGFILE}" "mged not found at location \"${MGED_EXEC}\" - aborting\n")
  file(READ "${LOGFILE}" LOG)
  message(FATAL_ERROR "Unable to find mged, aborting.\nSee ${LOGFILE} for more details.\n${LOG}")
endif(NOT EXISTS "${MGED_EXEC}")

# Create the .g file, or copy a test-specific input database.
set(GFILE "${TEST_WORKING_DIRECTORY}/${TNAME}.g")
execute_process(
  COMMAND "@CMAKE_COMMAND@" -E remove -f "${GFILE}"
)
if(TEST_DB)
  execute_process(
    COMMAND "@CMAKE_COMMAND@" -E copy "${TEST_DB}" "${GFILE}"
    RESULT_VARIABLE mged_result
    OUTPUT_VARIABLE mged_log
    ERROR_VARIABLE mged_log
  )
else()
  execute_process(
    COMMAND "${MGED_EXEC}" -c "${GFILE}" ls
    RESULT_VARIABLE mged_result
    OUTPUT_VARIABLE mged_log
    ERROR_VARIABLE mged_log
  )
endif()
file(APPEND "${LOGFILE}" "${mged_log}")
set(mged_log)
if(mged_result)
  file(READ "${LOGFILE}" LOG)
  message(FATAL_ERROR "[mged ${TNAME}] Failure: ${mged_result}. See ${LOGFILE} for more info.\n${LOG}")
endif(mged_result)

# Source every script as one Tcl command.  This both preserves substitutions
# in assertions and prevents event servicing from re-entering scripted stdin.
# MGED can exit successfully after Tcl errors, so require our own completion
# marker as well as the process status.
set(DRIVER_CONTENTS [=[
if {[catch {source {@TEST_SOURCE@}} result options]} {
    puts stderr "FAIL: regress-mged_@TNAME@: $result"
    if {[dict exists $options -errorinfo]} {
        puts stderr [dict get $options -errorinfo]
    }
    return
}
# MGED can defer a requested quit until the surrounding Tcl command returns.
if {[info exists mged_shutting_down] && $mged_shutting_down} {
    return
}
puts "PASS regress-mged_@TNAME@"
]=])
string(CONFIGURE "${DRIVER_CONTENTS}" DRIVER_CONTENTS @ONLY)
set(DRIVER "${TEST_WORKING_DIRECTORY}/run.tcl")
file(WRITE "${DRIVER}" "set regression_fixture_directory {${CBDIR}}\n${DRIVER_CONTENTS}")
execute_process(
  COMMAND "${MGED_EXEC}" -c "${GFILE}" "source {${DRIVER}}"
  WORKING_DIRECTORY "${TEST_WORKING_DIRECTORY}"
  RESULT_VARIABLE mged_result
  OUTPUT_VARIABLE mged_log
  ERROR_VARIABLE mged_log
)
file(APPEND "${LOGFILE}" "${mged_log}")
if(mged_result)
  file(READ "${LOGFILE}" LOG)
  message(FATAL_ERROR "[mged ${TNAME}] Failure: ${mged_result}. See ${LOGFILE} for more info.\n${LOG}")
endif(mged_result)
string(FIND "${mged_log}" "PASS regress-mged_${TNAME}" completion_position)
if(completion_position EQUAL -1)
  message(FATAL_ERROR "[mged ${TNAME}] Script did not complete. See ${LOGFILE} for more info.\n${mged_log}")
endif()
if(TEST_EXPECT AND NOT mged_log MATCHES "${TEST_EXPECT}")
  file(READ "${LOGFILE}" LOG)
  message(FATAL_ERROR "[mged ${TNAME}] Expected output was not found. See ${LOGFILE} for more info.\n${LOG}")
endif()
if(TEST_REJECT)
  foreach(reject_string IN LISTS TEST_REJECT)
    string(FIND "${mged_log}" "${reject_string}" reject_position)
    if(NOT reject_position EQUAL -1)
      file(READ "${LOGFILE}" LOG)
      message(FATAL_ERROR "[mged ${TNAME}] Forbidden output '${reject_string}' was found. See ${LOGFILE} for more info.\n${LOG}")
    endif()
  endforeach()
endif()
set(mged_log)

# Clean up
execute_process(
  COMMAND "@CMAKE_COMMAND@" -E rm -rf ${BU_DIR_CACHE}
)
execute_process(
  COMMAND "@CMAKE_COMMAND@" -E rm -rf ${LIBRT_CACHE}
)
if(NOT TEST_KEEP_DB)
  file(REMOVE "${GFILE}")
endif()

# Local Variables:
# tab-width: 8
# mode: cmake
# indent-tabs-mode: t
# End:
# ex: shiftwidth=2 tabstop=8
