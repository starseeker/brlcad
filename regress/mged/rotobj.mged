puts "*** Testing 'rotobj' command ***"

in_arb8 rotobj
comb rotobj.c u rotobj_arb8.s
set original_tree [get rotobj.c tree]
Z
e rotobj.c
oed / rotobj.c/rotobj_arb8.s
rotobj 10 10 10
rotobj 20 20 20
rotobj -i 10 10 10
rotobj -i 20 20 20
accept
regression_assert {[get rotobj.c tree] ne $original_tree} "rotobj did not change the combination matrix"
Z

puts "*** 'rotobj' testing completed ***"
