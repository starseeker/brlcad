puts "*** Testing 'prefix' command ***"

in_sph prefix 1
in_sph prefix 2
comb prefix_comb.c u prefix_sph1.s u prefix_sph2.s
set prefix_objects [expand prefix*]
regression_assert {[llength $prefix_objects] == 3} "prefix setup did not create three objects"
prefix has_ {*}$prefix_objects
foreach object $prefix_objects {
    regression_assert {![exists $object] && [exists has_$object]} "prefix did not rename $object"
}
set prefixed_tree [get has_prefix_comb.c tree]
regression_assert {[string first has_prefix_sph1.s $prefixed_tree] >= 0 &&
    [string first has_prefix_sph2.s $prefixed_tree] >= 0} "prefix did not update member references"

puts "*** 'prefix' testing completed ***"
