puts "*** Testing 'killtree' command ***"

proc killtree_setup {include_sketch} {
    in_sketch killtree "" .s
    in_extrude killtree "" .s killtree_sketch.s
    in_arb8 killtree
    in_arb8 killtree _1
    comb killtree_1.c u killtree_arb8_1.s
    comb killtree.c u killtree_1.c u killtree_arb8.s u killtree_extrude.s
    if {$include_sketch} {
        comb killtree.c u killtree_sketch.s
    }
    foreach object {killtree.c killtree_1.c killtree_arb8_1.s killtree_arb8.s killtree_extrude.s killtree_sketch.s} {
        regression_assert {[exists $object]} "killtree setup did not create $object"
    }
}

foreach include_sketch {1 0} {
    killtree_setup $include_sketch
    killtree killtree.c
    foreach object {killtree.c killtree_1.c killtree_arb8_1.s killtree_arb8.s killtree_extrude.s} {
        regression_assert {![exists $object]} "killtree left $object in the database"
    }
    regression_assert {[exists killtree_sketch.s] == !$include_sketch} "killtree mishandled the sketch support object"
}

in killtree_dup.s sph 0 0 0 1
comb killtree_dup.c u killtree_dup.s u killtree_dup.s
killtree killtree_dup.c killtree_dup.s
regression_assert {![exists killtree_dup.c] && ![exists killtree_dup.s]} "killtree left a duplicate operand in the database"

puts "*** 'killtree' testing completed ***"
