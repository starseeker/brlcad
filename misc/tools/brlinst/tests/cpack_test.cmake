foreach(_required IN ITEMS TEST_ROOT BRLINST FIXTURE_TOOL MODULE_DIR TEST_GENERATOR)
  if(NOT DEFINED ${_required})
    message(FATAL_ERROR "Missing test argument: ${_required}")
  endif()
endforeach()
function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error)
  if(NOT _result EQUAL 0)
    message(FATAL_ERROR "Test command failed: ${ARGV}\n${_output}\n${_error}")
  endif()
endfunction()
file(REMOVE_RECURSE "${TEST_ROOT}")
file(MAKE_DIRECTORY "${TEST_ROOT}/source" "${TEST_ROOT}/bin")
get_filename_component(_exe "${BRLINST}" NAME)
configure_file("${BRLINST}" "${TEST_ROOT}/bin/${_exe}" COPYONLY)
run("${FIXTURE_TOOL}" --fixture-stubs "${TEST_ROOT}/bin")
file(WRITE "${TEST_ROOT}/source/license.txt" "Test license\n")
file(WRITE "${TEST_ROOT}/source/payload.txt" "Test payload\n")
file(WRITE "${TEST_ROOT}/source/product.json" "{\"formatVersion\":1,\"id\":\"test.cpack\",\"name\":\"CPack Test\",\"version\":\"1.0.0\",\"architecture\":\"x64\",\"publisher\":\"Test\",\"license\":\"license.txt\",\"shortcuts\":[]}")
set(_formats exe)
if(TEST_MSI)
  list(APPEND _formats msi)
  get_filename_component(_generator_dir "${BRLINST}" DIRECTORY)
  configure_file("${_generator_dir}/brlinst-msi-actions.dll" "${TEST_ROOT}/bin/brlinst-msi-actions.dll" COPYONLY)
endif()
file(WRITE "${TEST_ROOT}/source/CMakeLists.txt" "
cmake_minimum_required(VERSION 3.22)
project(BrlinstCPackTest NONE)
set(CPACK_PACKAGE_NAME BrlinstCPackTest)
set(CPACK_PACKAGE_VERSION 1.0)
set(CPACK_PACKAGE_FILE_NAME test-setup)
install(FILES payload.txt DESTINATION .)
include(CPack)
include(\"${MODULE_DIR}/Brlinst.cmake\")
brlinst_add_package(FORMATS ${_formats} CONFIG \"${TEST_ROOT}/source/product.json\" EXECUTABLE \"${TEST_ROOT}/bin/${_exe}\")
")
run("${CMAKE_COMMAND}" -S "${TEST_ROOT}/source" -B "${TEST_ROOT}/build" -G "${TEST_GENERATOR}")
run("${CMAKE_COMMAND}" --build "${TEST_ROOT}/build" --config Release --target package-brlinst)
if(NOT EXISTS "${TEST_ROOT}/build/test-setup.exe")
  message(FATAL_ERROR "CPack did not publish the executable installer")
endif()
run("${BRLINST}" --verify "${TEST_ROOT}/build/test-setup.exe")

if(TEST_MSI)
  run("${CMAKE_COMMAND}" --build "${TEST_ROOT}/build" --config Release --target package-brlinst-msi)
  if(NOT EXISTS "${TEST_ROOT}/build/test-setup.exe" OR NOT EXISTS "${TEST_ROOT}/build/test-setup.msi")
    message(FATAL_ERROR "CPack did not retain both package formats")
  endif()
  run("${BRLINST}" --verify "${TEST_ROOT}/build/test-setup.msi")
endif()
