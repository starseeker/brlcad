# Optional integration without editing the BRL-CAD checkout:
# cmake ... -DCMAKE_PROJECT_BRLCAD_INCLUDE=/path/to/brlinst/cmake/BRLCAD.cmake
#           -DBRLINST_EXECUTABLE=/path/to/brlinst.exe
# The callback runs after BRL-CAD has defined its version and CPack setup.
include_guard(GLOBAL)
set(_BRLINST_MODULE_DIR "${CMAKE_CURRENT_LIST_DIR}")
function(brlinst_brlcad_configure)
  if(NOT WIN32)
    message(STATUS "brlinst BRL-CAD packaging integration requires a Windows build")
    return()
  endif()
  set(_filter OFF)
  if(NOT BRLINST_PRODUCT_CONFIG)
    set(_filter ON)
    # JSON quoting is performed by CMake's JSON serializer, not by interpolating
    # Windows paths into a text template.
    set(_product "{}")
    string(JSON _product SET "${_product}" formatVersion 1)
    set(_processor "${CMAKE_SYSTEM_PROCESSOR}")
    if(CMAKE_VS_PLATFORM_NAME)
      set(_processor "${CMAKE_VS_PLATFORM_NAME}")
    elseif(CMAKE_GENERATOR_PLATFORM)
      set(_processor "${CMAKE_GENERATOR_PLATFORM}")
    endif()
    if(_processor MATCHES "^(ARM64|arm64|aarch64)$")
      set(_architecture arm64)
    elseif(_processor MATCHES "^(AMD64|amd64|x86_64|x64)$")
      set(_architecture x64)
    else()
      message(FATAL_ERROR "brlinst supports x64 and ARM64 Windows packages, not ${_processor}")
    endif()
    string(JSON _product SET "${_product}" architecture "\"${_architecture}\"")
    foreach(_pair IN ITEMS id name version publisher website license icon welcome)
      if(_pair STREQUAL "icon" AND NOT CMAKE_HOST_WIN32)
        # Unix EXE packaging uses the resources already in the cross-built stub.
        continue()
      endif()
      if(_pair STREQUAL "id")
        set(_value "org.brlcad.brlcad")
      elseif(_pair STREQUAL "name")
        set(_value "BRL-CAD")
      elseif(_pair STREQUAL "version")
        set(_value "${BRLCAD_VERSION}")
      elseif(_pair STREQUAL "publisher")
        set(_value "BRL-CAD Development Team")
      elseif(_pair STREQUAL "website")
        set(_value "https://brlcad.org/")
      elseif(_pair STREQUAL "license")
        set(_value "${CMAKE_SOURCE_DIR}/COPYING")
      elseif(_pair STREQUAL "icon")
        set(_value "${CMAKE_SOURCE_DIR}/misc/cpack/icons/brlcad.ico")
      else()
        set(_value "BRL-CAD is an open source solid modeling system. This wizard will install this version separately from other installed versions.")
      endif()
      string(REPLACE "\\" "\\\\" _value "${_value}")
      string(REPLACE "\"" "\\\"" _value "${_value}")
      string(JSON _product SET "${_product}" "${_pair}" "\"${_value}\"")
    endforeach()
    set(_branding "{}")
    string(JSON _branding SET "${_branding}" style "\"classic\"")
    set(_exe_branding "{}")
    foreach(_asset IN ITEMS header sidebar)
      set(_value "${CMAKE_SOURCE_DIR}/misc/cpack/exe/${_asset}.bmp")
      string(REPLACE "\\" "\\\\" _value "${_value}")
      string(REPLACE "\"" "\\\"" _value "${_value}")
      string(JSON _exe_branding SET "${_exe_branding}" "${_asset}" "\"${_value}\"")
    endforeach()
    string(JSON _branding SET "${_branding}" exe "${_exe_branding}")
    set(_msi_branding "{}")
    foreach(_asset IN ITEMS icon license)
      if(_asset STREQUAL "icon")
        set(_filename "product.ico")
      elseif(_asset STREQUAL "license")
        set(_filename "license.rtf")
      endif()
      set(_value "${CMAKE_SOURCE_DIR}/misc/cpack/msi/${_filename}")
      string(REPLACE "\\" "\\\\" _value "${_value}")
      string(REPLACE "\"" "\\\"" _value "${_value}")
      string(JSON _msi_branding SET "${_msi_branding}" "${_asset}" "\"${_value}\"")
    endforeach()
    string(JSON _branding SET "${_branding}" msi "${_msi_branding}")
    string(JSON _product SET "${_product}" branding "${_branding}")
    set(_links "[]")
    foreach(_app IN ITEMS mged archer rtwizard)
      # Custom configurations may omit these tools. Only advertise built apps.
      if(TARGET "${_app}")
        if(_app STREQUAL "mged")
          set(_label "MGED")
        elseif(_app STREQUAL "archer")
          set(_label "Archer")
        else()
          set(_label "RtWizard")
        endif()
        string(JSON _count LENGTH "${_links}")
        string(JSON _links SET "${_links}" ${_count}
          "{\"name\":\"${_label}\",\"target\":\"${BIN_DIR}/${_app}.exe\",\"workingDirectory\":\"@profile\",\"desktop\":true}")
      endif()
    endforeach()
    foreach(_manual IN ITEMS "BRL-CAD" "MGED")
      if(_manual STREQUAL "BRL-CAD")
        set(_target "${DOC_DIR}/html/manuals/index.html")
      else()
        set(_target "${DOC_DIR}/html/manuals/mged/index.html")
      endif()
      string(JSON _count LENGTH "${_links}")
      string(JSON _links SET "${_links}" ${_count}
        "{\"name\":\"${_manual} Manual\",\"target\":\"${_target}\",\"desktop\":false}")
    endforeach()
    string(JSON _product SET "${_product}" shortcuts "${_links}")
    set(BRLINST_PRODUCT_CONFIG "${CMAKE_BINARY_DIR}/brlinst-product.json")
    file(WRITE "${BRLINST_PRODUCT_CONFIG}" "${_product}\n")
  endif()
  set(BRLINST_PRODUCT_CONFIG "${BRLINST_PRODUCT_CONFIG}" PARENT_SCOPE)
  set(BRLINST_FILTER_SHORTCUTS "${_filter}" PARENT_SCOPE)
endfunction()
function(_brlinst_brlcad_package)
  if(BRLINST_BUILTIN_INTEGRATION)
    return()
  endif()
  if(NOT BRLINST_EXECUTABLE)
    find_program(BRLINST_EXECUTABLE NAMES brlinst REQUIRED)
  endif()
  include("${_BRLINST_MODULE_DIR}/Brlinst.cmake")
  brlinst_brlcad_configure()
  if(NOT DEFINED BRLINST_FORMATS)
    if(CMAKE_HOST_WIN32)
      set(BRLINST_FORMATS exe msi)
    else()
      set(BRLINST_FORMATS exe)
    endif()
  endif()
  set(_filter)
  if(BRLINST_FILTER_SHORTCUTS)
    set(_filter FILTER_SHORTCUTS)
  endif()
  brlinst_add_package(FORMATS ${BRLINST_FORMATS} CONFIG "${BRLINST_PRODUCT_CONFIG}"
    EXECUTABLE "${BRLINST_EXECUTABLE}" ${_filter})
endfunction()
cmake_language(DEFER CALL _brlinst_brlcad_package)
