puts "*** Testing 'unhide' command ***"

in_arb8 unhide 1
in_arb8 unhide 2
comb unhidden.c u unhide_arb81.s u unhide_arb82.s
hide unhide_arb81.s
hide unhidden.c
regression_assert {[lsearch -exact [ls] unhide_arb81.s] < 0} "unhide setup did not hide the primitive"
regression_assert {![regexp {unhidden\.c} [ls]]} "unhide setup did not hide the combination"
unhide unhide_arb81.s
regression_assert {[lsearch -exact [ls] unhide_arb81.s] >= 0} "unhide did not restore the primitive listing"
regression_assert {![regexp {unhidden\.c} [ls]]} "unhide changed an unselected combination"
unhide unhidden.c
regression_assert {[regexp {unhidden\.c} [ls]]} "unhide did not restore the combination listing"

puts "*** 'unhide' testing completed ***"
